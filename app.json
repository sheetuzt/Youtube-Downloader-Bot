{
  "name": "YouTube Downloader Bot",
  "description": "A Telegram bot to download single YouTube videos",
  "logo": "https://telegra.ph/file/6a3b1febade2313dd0dca.jpg",
  "keywords": [
    "youtube",
    "youtube-downloader",
    "telegram-bot"
  ],
  "repository": "https://github.com/sheetuzt/Youtube-Downloader-Bot",
  "success_url": "https://telegram.me/",
  "website": "https://github.com/sheetuzt/Youtube-Downloader-Bot",
  "env": {
    "API_ID": {
      "description": "Telegram API ID from https://my.telegram.org",
      "required": true
    },
    "API_HASH": {
      "description": "Telegram API hash from https://my.telegram.org",
      "required": true
    },
    "BOT_TOKEN": {
      "description": "Telegram bot token from @BotFather",
      "required": true
    },
    "YOUTUBE_PROXY": {
      "description": "Optional HTTP/SOCKS proxy URL if YouTube blocks the Heroku IP",
      "required": false
    },
    "YTDLP_PLAYER_CLIENTS": {
      "description": "Optional comma-separated yt-dlp YouTube clients",
      "value": "android_vr,ios,web_safari",
      "required": false
    }
  },
  "buildpacks": [
    {
      "url": "https://github.com/jonathanong/heroku-buildpack-ffmpeg-latest.git"
    },
    {
      "url": "https://github.com/chibat/heroku-buildpack-deno.git"
    },
    {
      "url": "heroku/python"
    }
  ],
  "formation": {
    "worker": {
      "quantity": 1,
      "size": "basic"
    }
  },
  "stack": "heroku-24"
}
